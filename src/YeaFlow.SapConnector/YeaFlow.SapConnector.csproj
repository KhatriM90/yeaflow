<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- Ships as a self-contained Windows service next to SAP; no runtime to install on the customer server. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <UserSecretsId>yeaflow-sapconnector</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\YeaFlow.Sap.Contracts\YeaFlow.Sap.Contracts.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="YeaFlow.UnitTests" />
  </ItemGroup>
</Project>
